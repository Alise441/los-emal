# Copy to .env (docker compose reads it automatically) or export in your shell.

# --- Apertus (required) -------------------------------------------------------
# Any OpenAI-compatible endpoint serving Apertus 1.5:
#   Public AI (Swiss jurisdiction):  https://api.publicai.co/v1   model swiss-ai/apertus-v1.5-70b
#   Hugging Face router:             https://router.huggingface.co/v1   model swiss-ai/Apertus-v1.5-70B:featherless-ai
#                                    (HF token with "Inference Providers" permission; billed to HF credits)
#   Self-hosted vLLM (on-premise):   http://localhost:8000/v1   model swiss-ai/Apertus-v1.5-70B
LLM_NAME=swiss-ai/apertus-v1.5-70b
LLM_BASE_URL=https://api.publicai.co/v1
LLM_API_KEY=
# Optional: model to switch to when LLM_NAME is throttled (HTTP 429). On Public AI the app falls
# back from 70B to swiss-ai/apertus-v1.5-8b by default.
# LLM_FALLBACK_NAME=
# Optional, for debugging: append every request and reply to this JSONL file (contains learner input)
# LLM_LOG=logs/llm_calls.jsonl

# --- The local's lines ---------------------------------------------------------
# de (default): Apertus writes each line in Swiss Standard German and a translator turns it into Zurich German;
# gsw: Apertus writes Zurich German itself.
DIALOGUE=de
# Optional translator Standard German -> Zurich German (also used for "how a local would say it"): any
# OpenAI-compatible endpoint, e.g. our research model fine-tuned on SwissDial (non-commercial, not part of the
# submission, see technical report E5) served on a Mac with
#   mlx_lm.server --model alise441/apertus-v1.5-8b-de-to-zurich-mlx-4bit --port 8080
# From Docker use http://host.docker.internal:8080/v1. Empty: Apertus (LLM_NAME) translates.
# GSW_BASE_URL=http://localhost:8080/v1
# GSW_MODEL=default_model

# --- Speech recognition ---------------------------------------------------------
# faster-whisper (CPU/CUDA, default) | mlx (Apple Silicon, native runs only) | none
ASR_BACKEND=faster-whisper
ASR_MODEL=large-v3-turbo

# --- Speech synthesis ---------------------------------------------------------
# qwen | none.  0.6B is the CPU-friendly default; use the 1.7B model on a GPU / Apple Silicon.
TTS_BACKEND=qwen
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
# Optional: your own consented reference recording and its exact transcript (for all roles, or with
# TTS_REF_WAV_M / TTS_REF_TEXT_M only for the male roles)
# TTS_REF_WAV=/path/to/voice.wav
# TTS_REF_TEXT=...
